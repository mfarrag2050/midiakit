# pf-mediakit — متغيرات البيئة. انسخه إلى `.env` وعدّل حسب حاجتك.
# **مهم:** الميني يشارك Redis مع مشاريع أخرى (منهاج وغيره). لعزل
# طوابيرنا نستعمل قاعدة منفصلة + بادئة مفاتيح.

# ── apps/studio (mk-studio) ────────────────────────
# NEXT_PUBLIC_API_URL: أصل mk-api (يحتاجه client.ts في الوضع الحقيقي).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:19040
#
# NEXT_PUBLIC_API_MOCK: يبدّل client.ts إلى `src/api/mock.ts` — يخدم
# S5 قبل فتح SYNC-α. عند اكتمال A6-A8، احذف السطر أو اجعله `false`.
# NEXT_PUBLIC_API_MOCK=true

# ── Redis ──────────────────────────────────────────
# قاعدة 3 معزولة عمّا عليه المشاريع الأخرى (منهاج/PrimeMind على 0-2).
REDIS_URL=redis://127.0.0.1:6379/3

# بادئة كل مفاتيح BullMQ (queues, jobs, locks). يمنع الاصطدام مع أي
# مشروع آخر يستعمل Redis على نفس المُضيف.
BULLMQ_PREFIX=pf-mediakit

# ── تكوين العمال ──────────────────────────────────
# العدد الأقصى للعمال المتوازيين لكل طابور.
# urgent ثابت على 2 (يتطلّبه SLA للفيديو العاجل).
# normal الافتراضي floor(cores/2) — يتغيّر حسب الجهاز.
# edit ثابت على 1 (مشاريع التحرير تتنافس على القرص — ملف 10).
# batch ثابت على 1، يعمل ليلاً.
# WORKER_NORMAL=4    # تجاوز صريح إن أردت

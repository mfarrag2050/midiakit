{
  "id": "manara-agency",
  "name": "مَنارة — وكالة تجريبيّة",
  "version": 1,
  "direction": "rtl",
  "locale": "ar",

  "fonts": {
    "primary": {
      "family": "IBM Plex Sans Arabic",
      "source": "builtin",
      "licenseAck": true,
      "weights": {
        "light":   { "url": "assets/fonts/IBMPlexSansArabic-Light.ttf",   "value": 300, "metrics": { "ascent": 1085, "descent": 415, "unitsPerEm": 1000 } },
        "regular": { "url": "assets/fonts/IBMPlexSansArabic-Regular.ttf", "value": 400, "metrics": { "ascent": 1085, "descent": 415, "unitsPerEm": 1000 } },
        "bold":    { "url": "assets/fonts/IBMPlexSansArabic-Bold.ttf",    "value": 700, "metrics": { "ascent": 1085, "descent": 415, "unitsPerEm": 1000 } }
      }
    },
    "fallback": "sans-serif",
    "capabilities": {
      "kashida": true,
      "kashidaMethod": "tatweel",
      "variableAxes": [],
      "diacriticsSafe": true
    }
  },

  "colors": {
    "text": "#1A2733",
    "accent": "#B23A48",
    "urgentBadge": "#FFD166",
    "urgentBg": "#1A2733",
    "urgentBgTint": "#2E3F52",
    "urgentText": "#F5F1E8",
    "locationBadge": "#3A7D6C",
    "surface": "#F5F1E8",
    "placeholder": ["#E5DFCE", "#F5F1E8"]
  },

  "logo": {
    "url": "",
    "size": 72,
    "margin": 60,
    "position": "top-left",
    "watermark": {
      "enabled": false,
      "scale": 0.95,
      "offsetX": -0.12,
      "opacity": 0.55,
      "tint": "colors.urgentBgTint"
    }
  },

  "typography": {
    "headline":  { "max": 96, "min": 40, "lineHeight": 1.30, "boxWidth": 880 },
    "breaking":  {
      "max": 96,
      "min": 44,
      "lineHeight": 1.36,
      "boxWidth": 900,
      "shortLineRatio": 1.0,
      "maxLines": 5,
      "minLines": 2,
      "preferredLines": 3,
      "readableMinRatio": 0.05,
      "targetFill": 0.9,
      "wrapMode": "uniform",
      "headlineFsRatio": [0.065, 0.085],
      "boxWidthRange": [0.68, 0.86]
    },
    "kicker":    { "max": 60, "min": 28, "weight": 300, "boxWidth": 760, "gapBelow": 56 },
    "title3l":   { "max": 92, "min": 44, "minLines": 1, "preferredLines": 2 },
    "source":    { "size": 38, "weight": 700 },
    "reelTitle": {
      "max": 88, "min": 44, "maxLines": 4,
      "boxInset": 150, "verticalAnchor": 0.66,
      "lineHeight": 1.32,
      "boxWidth": 800,
      "shortLineRatio": 0.6,
      "minLines": 1,
      "preferredLines": 2,
      "readableMinRatio": 0.045,
      "headlineFsRatio": [0.055, 0.075],
      "boxWidthRange": [0.68, 0.86]
    },
    "accentBar": { "height": 10, "minWidth": 160, "maxWidth": 640 },
    "lineHeightMode": "dynamic",
    "justify": {
      "mode": "kashida",
      "maxStretchPerSite": 0.35,
      "maxSitesPerWord": 1,
      "minLineFill": 0.82,
      "lastLine": "natural"
    },
    "semanticBreaks": { "enabled": false, "useModel": "never" },
    "diacritics":     { "enabled": false, "mode": "full" },
    "bidi":           { "enabled": true, "numerals": "arabic" }
  },

  "badges": {
    "urgent": {
      "label": "خبر عاجل",
      "fontSize": 44,
      "height": 72,
      "paddingX": 34,
      "radius": 6,
      "fill": "colors.urgentBadge",
      "textColor": "colors.urgentBg"
    },
    "location": {
      "fontSize": 36,
      "height": 58,
      "paddingX": 22,
      "radius": 8,
      "fill": "colors.locationBadge",
      "textColor": "colors.surface",
      "margin": { "x": 60, "y": 60 },
      "anchor": "top-right"
    }
  },

  "gradient": {
    "defaultOpacity": 0.60,
    "defaultReach": 0.80,
    "color": "#F5F1E8",
    "urgentColor": "#1A2733",
    "shape": [[0,1],[0.20,0.98],[0.40,0.82],[0.60,0.48],[0.80,0.06],[0.92,0]],
    "band":  [[0,0.08],[0.20,0.5],[0.36,0.92],[0.5,1.0],[0.64,0.92],[0.80,0.5],[1,0.08]]
  },

  "shadows": {
    "reelTitle": { "color": "rgba(26,39,51,0.62)", "blur": 24, "offsetY": 2 }
  },

  "margins": {
    "contentRight": 90,
    "breakingBaseline": 220,
    "sourceBaseline": 150,
    "badgeGap": 36,
    "cardTopPortrait": 170,
    "cardBottomS01": 350
  },

  "motion": {
    "segmentMin": 7,
    "segmentMax": 10,
    "segmentWordBase": 8,
    "segmentWordStep": 0.3,
    "crossfade": 0.6,
    "reelCrossfade": 0.5,
    "titleFadeIn": 0.45,
    "titleFadeOut": 0.5,
    "badgeDelay": 0.25,
    "badgeFade": 0.45,
    "lineStagger": 0.12,
    "lineFade": 0.42,
    "outro": 0.5,
    "badgePulse": 0.05
  },

  "outputs": {
    "x":         { "w": 1080, "h": 1080 },
    "instagram": { "w": 1080, "h": 1440 },
    "feed":      { "w": 1080, "h": 1350 },
    "reel":      { "w": 1080, "h": 1920 }
  },

  "audio": [],

  "placement": {
    "logo":        { "anchor": "top-left",     "offset": { "x": 60, "y": 60 } },
    "badge":       { "anchor": "top-right",    "offset": { "x": 60, "y": 60 } },
    "attribution": { "anchor": "bottom-right", "offset": { "x": 60, "y": 60 } },
    "source":      { "anchor": "bottom-right", "offset": { "x": 60, "y": 150 } }
  },

  "attribution": {
    "logoMode": "generic",
    "platformNameStyle": "ar",
    "separator": " · ",
    "iconSize": 48,
    "logoAcks": {
      "tiktok":    { "licenseAck": false, "ackBy": "", "ackAt": "" },
      "x":         { "licenseAck": false, "ackBy": "", "ackAt": "" },
      "instagram": { "licenseAck": false, "ackBy": "", "ackAt": "" },
      "youtube":   { "licenseAck": false, "ackBy": "", "ackAt": "" },
      "telegram":  { "licenseAck": false, "ackBy": "", "ackAt": "" },
      "facebook":  { "licenseAck": false, "ackBy": "", "ackAt": "" }
    }
  }
}

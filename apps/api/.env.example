# apps/api بيئة التشغيل
# انسخ إلى .env (لا يُتَتبَّع). الأسرار الحقيقية للإنتاج خارج المستودع.

# قاعدة البيانات — app_user حصراً (NOSUPERUSER NOBYPASSRLS)
DATABASE_URL_APP=postgres://app_user:dev_app_pass@127.0.0.1:19041/mediakit

# سرّ JWT (HS256) — ≥32 بايت عشوائي
# للتوليد: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_JWT_SECRET=dev_secret_change_in_production_min_32_bytes_long_placeholder

# منفذ الاستماع
PORT=19040

# بيئة (development | test | production)
NODE_ENV=development

# CORS origin — الواجهة (mk-studio على 19050 محلياً)
CORS_ORIGIN=http://127.0.0.1:19050

# SMTP — اختياري في dev/test، **إلزامي في production** (config يفشل بدونه).
# في dev: تُطبع الرسائل في السجل بدل الإرسال.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@yourdomain
# SMTP_PASS=xxx
# SMTP_FROM=noreply@yourdomain

# ── التخزين (A11-STORAGE) ─────────────────────────────
# STORAGE_DRIVER: 'memory' (in-process، للاختبارات المفصولة) أو 's3'
# (يشمل MinIO في dev + R2/S3 في production). الافتراضي: 's3' في dev
# بعد A11-STORAGE — لأن MinIO يعمل في bin/mk.
STORAGE_DRIVER=s3

# MinIO في dev — hardcoded defaults في docker-compose. غيّرها في
# production. superRefine في config يفشل في production إن كانت المفاتيح
# غائبة مع DRIVER=s3.
S3_ENDPOINT=http://127.0.0.1:19043
S3_REGION=us-east-1
S3_BUCKET=mk-assets-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_TTL_SECONDS=900
STORAGE_MAX_SIZE_BYTES=524288000

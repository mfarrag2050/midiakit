{
  "name": "pf-mediakit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "20.18.1"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "check:engine-purity": "node scripts/check-engine-purity.mjs",
    "test": "pnpm check:engine-purity && vitest run",
    "test:watch": "vitest",
    "preview": "node --import tsx scripts/preview.mjs",
    "preview:attribution": "node --import tsx scripts/preview-attribution.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "render:mp4": "node --import tsx apps/renderer/src/cli.ts"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "@types/node": "20.17.10",
    "skia-canvas": "3.0.8",
    "tsx": "4.19.2",
    "@pf-mediakit/engine": "workspace:*",
    "@pf-mediakit/shared": "workspace:*",
    "@pf-mediakit/templates": "workspace:*",
    "@pf-mediakit/renderer": "workspace:*"
  }
}

{
  "name": "pf-mediakit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "20.18.1"
  },
  "scripts": {
    "typecheck": "node scripts/typecheck-all.mjs",
    "check:engine-purity": "node scripts/check-engine-purity.mjs",
    "check:no-brand-leak": "node scripts/check-no-brand-leak.mjs",
    "check:doc-paths": "node scripts/check-doc-paths.mjs",
    "check:lessons-sequence": "node scripts/check-lessons-sequence.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check:skill-fresh": "node scripts/check-skill-fresh.mjs",
    "check:no-git-internals": "node scripts/check-no-git-internals.mjs",
    "check:script-paths": "node scripts/check-script-paths.mjs",
    "check:dashboard-not-published": "node scripts/check-dashboard-not-published.mjs",
    "check:docs-bundle-fresh": "node scripts/check-docs-bundle-fresh.mjs",
    "docs:bundle": "node scripts/bundle-docs.mjs",
    "skill:build": "node scripts/build-skill.mjs",
    "skill:publish": "pnpm skill:build && pnpm docs:bundle",
    "test": "pnpm check:engine-purity && pnpm check:no-brand-leak && pnpm check:doc-paths && pnpm check:lessons-sequence && pnpm check:docker-context && pnpm check:no-git-internals && pnpm check:script-paths && pnpm check:dashboard-not-published && pnpm check:skill-fresh && pnpm check:docs-bundle-fresh && pnpm check:no-brand-url-fetch && pnpm check:no-paddle-outside-payments && pnpm check:no-ai-provider-outside-ai && pnpm check:brand-kit-patch-coverage && pnpm check:observe-import-scope && pnpm check:template-sync && pnpm check:plan-sync && pnpm check:control-plane-policies && pnpm check:response-envelope && vitest run && pnpm verify:render-video-all-templates && pnpm verify:image-layer && pnpm verify:image-fixture && pnpm verify:plan-values && pnpm verify:snapshot && pnpm verify:breaking-video && pnpm verify:caption-kashida-stability && pnpm verify:audio-gate && pnpm verify:media-track-gate && pnpm verify:text-tracks-gate && pnpm verify:transitions-gate",
    "test:watch": "vitest",
    "preview": "node --import tsx scripts/preview.mjs",
    "preview:attribution": "node --import tsx scripts/preview-attribution.mjs",
    "preview:placement": "node --import tsx scripts/preview-placement.mjs",
    "preview:caption": "node --import tsx scripts/preview-caption.mjs",
    "preview:svg": "node --import tsx scripts/preview-svg.mjs",
    "verify:svg": "node --import tsx scripts/verify-svg-gate.mjs",
    "verify:smart-crop": "node --import tsx scripts/verify-smart-crop-gate.mjs",
    "verify:tts": "node --import tsx scripts/verify-tts-gate.mjs",
    "verify:perf": "node --import tsx scripts/verify-perf-gate.mjs",
    "verify:tenant-isolation": "pnpm --filter @pf-mediakit/db verify:isolation",
    "verify:multilang": "node --import tsx scripts/verify-multilang-gate.mjs",
    "verify:tashkil-collision": "node --import tsx scripts/verify-tashkil-collision.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "verify:plan-all-templates": "node --import tsx scripts/verify-plan-all-templates.mjs",
    "verify:render-video-all-templates": "node --import tsx scripts/verify-render-video-all-templates.mjs",
    "verify:image-layer": "node --import tsx scripts/verify-image-layer.mjs",
    "verify:image-fixture": "node --import tsx scripts/verify-image-fixture.mjs",
    "verify:plan-values": "node --import tsx scripts/verify-plan-values.mjs",
    "verify:breaking-video": "node scripts/verify-breaking-video.mjs",
    "verify:caption-kashida-stability": "node --import tsx scripts/verify-caption-kashida-stability.mjs",
    "verify:audio-gate": "node --import tsx scripts/verify-audio-gate.mjs",
    "verify:media-track-gate": "node --import tsx scripts/verify-media-track-gate.mjs",
    "verify:text-tracks-gate": "node --import tsx scripts/verify-text-tracks-gate.mjs",
    "verify:transitions-gate": "node --import tsx scripts/verify-transitions-gate.mjs",
    "render:mp4": "node --import tsx apps/renderer/src/cli.ts",
    "demo:live": "node --import tsx scripts/demo-live.mjs",
    "measure-font": "node scripts/measure-font-metrics.mjs",
    "check:no-brand-url-fetch": "node scripts/check-no-brand-url-fetch.mjs",
    "check:no-paddle-outside-payments": "node scripts/check-no-paddle-outside-payments.mjs",
    "check:no-ai-provider-outside-ai": "node scripts/check-no-ai-provider-outside-ai.mjs",
    "check:brand-kit-patch-coverage": "node scripts/check-brand-kit-patch-coverage.mjs",
    "check:observe-import-scope": "node scripts/check-observe-import-scope.mjs",
    "check:template-sync": "pnpm --filter @pf-mediakit/db check:template-sync",
    "check:plan-sync": "pnpm --filter @pf-mediakit/db check:plan-sync",
    "check:control-plane-policies": "pnpm --filter @pf-mediakit/db check:control-plane-policies",
    "check:response-envelope": "node scripts/check-response-envelope.mjs",
    "db:up": "./bin/mk -f infra/docker-compose.yml up -d",
    "db:down": "./bin/mk -f infra/docker-compose.yml down",
    "db:logs": "./bin/mk -f infra/docker-compose.yml logs -f",
    "db:reset": "./bin/mk -f infra/docker-compose.yml down -v && pnpm db:up",
    "db:migrate": "pnpm --filter @pf-mediakit/db migrate:up",
    "db:migrate:test": "pnpm --filter @pf-mediakit/db migrate:up:test",
    "verify:auth": "pnpm --filter @pf-mediakit/api verify:auth",
    "verify:brand-kits": "pnpm --filter @pf-mediakit/api verify:brand-kits",
    "verify:tenant": "pnpm --filter @pf-mediakit/api verify:tenant",
    "verify:users": "pnpm --filter @pf-mediakit/api verify:users",
    "verify:assets": "pnpm --filter @pf-mediakit/api verify:assets",
    "verify:templates": "pnpm --filter @pf-mediakit/api verify:templates",
    "verify:projects": "pnpm --filter @pf-mediakit/api verify:projects",
    "verify:workflows": "pnpm --filter @pf-mediakit/api verify:workflows",
    "verify:renders": "pnpm --filter @pf-mediakit/api verify:renders",
    "verify:revisions": "pnpm --filter @pf-mediakit/api verify:revisions",
    "verify:plans": "pnpm --filter @pf-mediakit/api verify:plans",
    "verify:control-plane": "pnpm --filter @pf-mediakit/api verify:control-plane",
    "verify:a18-5": "pnpm --filter @pf-mediakit/api verify:a18-5",
    "verify:a18-6": "pnpm --filter @pf-mediakit/api verify:a18-6",
    "verify:a21": "pnpm --filter @pf-mediakit/api verify:a21",
    "verify:a22": "pnpm --filter @pf-mediakit/api verify:a22",
    "verify:a23": "pnpm --filter @pf-mediakit/api verify:a23",
    "verify:bk-numerals": "pnpm --filter @pf-mediakit/api verify:bk-numerals",
    "verify:a24": "pnpm --filter @pf-mediakit/api verify:a24",
    "verify:a25": "pnpm --filter @pf-mediakit/api verify:a25",
    "verify:a28": "pnpm --filter @pf-mediakit/api verify:a28",
    "verify:debt1": "pnpm --filter @pf-mediakit/api verify:debt1",
    "verify:limits1": "pnpm --filter @pf-mediakit/api verify:limits1",
    "verify:alerts-wire": "pnpm --filter @pf-mediakit/api verify:alerts-wire",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@pf-mediakit/engine": "workspace:*",
    "@pf-mediakit/renderer": "workspace:*",
    "@pf-mediakit/shared": "workspace:*",
    "@pf-mediakit/templates": "workspace:*",
    "@pf-mediakit/tts": "workspace:*",
    "@types/node": "20.17.10",
    "opentype.js": "^2.0.0",
    "skia-canvas": "3.0.8",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}

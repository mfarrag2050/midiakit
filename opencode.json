{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "primeflow": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PrimeFlow gateway (local)",
      "options": {
        "baseURL": "http://127.0.0.1:19400/v1",
        "apiKey": "{env:PF_GATEWAY_OPENCODE}"
      },
      "models": {
        "primeflow-architecture-review": {
          "name": "GLM 5.2 — builder (SWE-bench 82.8)"
        },
        "primeflow-qualification-deepseek": {
          "name": "DeepSeek V4.1 Flash — fast"
        },
        "primeflow-agentic-longcontext": {
          "name": "MiniMax M3 — 1M context"
        }
      }
    }
  },
  "model": "primeflow/primeflow-architecture-review",
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "webfetch": "deny"
  },
  "instructions": [
    "AGENTS.md"
  ]
}
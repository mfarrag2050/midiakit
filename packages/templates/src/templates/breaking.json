{
  "id": "breaking",
  "name": "بطاقة عاجل",
  "kind": "static",
  "sizes": ["x", "instagram", "feed"],
  "fields": [
    {
      "key": "headline",
      "type": "richtext",
      "required": true,
      "wordRange": [8, 20],
      "hint": "Enter = كسر سطر يدوي"
    },
    { "key": "source", "type": "text", "required": false },
    { "key": "image", "type": "image", "required": false },
    {
      "key": "sourceHandle",
      "type": "text",
      "required": false,
      "hint": "مقبض المصدر (مثال: @user)"
    },
    {
      "key": "sourceName",
      "type": "text",
      "required": false,
      "hint": "اسم صاحب المصدر"
    }
  ],
  "layers": [
    {
      "type": "image",
      "field": "image",
      "fit": "cover",
      "fallback": [
        { "type": "solid", "fill": "brand.colors.urgentBg" },
        { "type": "gradient", "direction": "bottom" }
      ]
    },
    {
      "type": "gradient",
      "direction": "bottom",
      "onlyIf": "hasImage"
    },
    {
      "type": "headline",
      "field": "headline",
      "wrap": "uniform",
      "align": "right",
      "anchor": "centerLower",
      "verticalAnchor": 0.62,
      "font": "brand.typography.breaking",
      "justify": "brand.typography.justify"
    },
    {
      "type": "badge",
      "use": "brand.badges.urgent",
      "anchor": "above-headline",
      "gap": "brand.margins.badgeGap"
    },
    {
      "type": "source",
      "field": "source",
      "anchor": "below-headline",
      "gapFsRatio": 1.4,
      "font": "brand.typography.source"
    },
    { "type": "logo" },
    {
      "type": "attribution",
      "platform": "tiktok",
      "mode": "both",
      "handleField": "sourceHandle",
      "nameField": "sourceName"
    }
  ],
  "video": {
    "animation": [
      { "target": "badge",    "at": 0,    "fade": 0.35, "pulse": true },
      { "target": "headline", "at": 0.30,
        "stagger": "brand.motion.lineStagger",
        "fade": "brand.motion.lineFade",
        "slideY": 26 },
      { "target": "source",   "after": "headline", "fade": 0.35 }
    ],
    "outro": "brand.motion.outro",
    "easing": "easeOutCubic"
  }
}

{
  "id": "card_centered",
  "name": "بطاقة متمركزة",
  "kind": "static",
  "sizes": ["x", "instagram"],
  "fields": [
    { "key": "headline", "type": "richtext", "required": true, "wordRange": [4, 14] },
    { "key": "image", "type": "image", "required": false }
  ],
  "layers": [
    {
      "type": "image",
      "field": "image",
      "fit": "cover",
      "fallback": [
        { "type": "solid", "fill": "brand.colors.surface" }
      ]
    },
    { "type": "gradient", "direction": "center", "onlyIf": "hasImage" },
    {
      "type": "headline",
      "field": "headline",
      "wrap": "uniform",
      "align": "center",
      "anchor": "middle",
      "font": "brand.typography.headline",
      "justify": "brand.typography.justify"
    },
    { "type": "accent", "mode": "span" },
    { "type": "logo" }
  ]
}

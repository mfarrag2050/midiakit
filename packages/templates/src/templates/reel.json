{
  "id": "reel",
  "name": "ريلز",
  "kind": "video",
  "sizes": ["reel", "x", "feed"],
  "fields": [
    { "key": "title", "type": "richtext", "required": true, "wordRange": [1, 7] },
    { "key": "location", "type": "text", "required": false },
    {
      "key": "clips",
      "type": "medialist",
      "required": true,
      "accepts": ["video", "image"]
    },
    {
      "key": "sourceHandle",
      "type": "text",
      "required": false,
      "hint": "مقبض المصدر (مثال: @user)"
    },
    {
      "key": "sourceName",
      "type": "text",
      "required": false,
      "hint": "اسم صاحب المصدر"
    }
  ],
  "layers": [
    { "type": "solid", "fill": "brand.colors.surface" },
    {
      "type": "headline",
      "field": "title",
      "wrap": "alternating",
      "align": "right",
      "anchor": "centerLower",
      "verticalAnchor": 0.66,
      "font": "brand.typography.reelTitle",
      "justify": "brand.typography.justify"
    },
    {
      "type": "badge",
      "use": "brand.badges.location",
      "field": "location",
      "anchor": "above-headline",
      "gap": "brand.margins.badgeGap",
      "constraint": true,
      "//": "شارة الموقع في الريلز فوق العنوان مباشرة — يقرأها المشاهد قبل التركيز على العنوان (سياق جغرافي قبل السرد)."
    },
    { "type": "logo" },
    {
      "type": "attribution",
      "platform": "instagram",
      "mode": "handle",
      "handleField": "sourceHandle"
    }
  ]
}

# packages/db بيئة الاتصال المحلية
# انسخ إلى .env (لا يُتَتبَّع). الأسرار الحقيقية للإنتاج خارج المستودع.
#
# التصريحان تحت — DEV و TEST — يشيران إلى حاويتَي docker-compose:
#   dev  → 127.0.0.1:19041/mediakit
#   test → 127.0.0.1:19042/mediakit_test
#
# node-pg-migrate يقرأ DATABASE_URL افتراضياً. migrations تستعمل
# migration_user، تطبيقك يستعمل app_user.

# ── DEV ──────────────────────────────────────────────
DATABASE_URL=postgres://migration_user:dev_migration_pass@127.0.0.1:19041/mediakit
DATABASE_URL_APP=postgres://app_user:dev_app_pass@127.0.0.1:19041/mediakit

# ── TEST (يُستعمل من scripts/verify-tenant-isolation.mjs) ──────
DATABASE_URL_TEST=postgres://migration_user:dev_migration_pass@127.0.0.1:19042/mediakit_test
DATABASE_URL_TEST_APP=postgres://app_user:dev_app_pass@127.0.0.1:19042/mediakit_test

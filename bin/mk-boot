#!/usr/bin/env bash
# bin/mk-boot — وكيلُ النهوض · يوقظُ الطقمَ ويثبِتُ كلَّ قطعة.
#
# **العلّة:** ليلة 2026-09-14 أعاد macOS تشغيلَ الميني وحده لتحديثٍ مجدوَل،
# فمات كلُّ شيء: colima · حاويّات · API · Studio · العامل · شاشاتُ tmux.
# كلَّفنا النهوضُ ساعةً من اللصق اليدويّ. هذا السكربتُ يُعيدها بأمرٍ واحد،
# **مقيسٍ لا مصدَّقٍ:** كلُّ قطعةٍ لها سطرُ برهانٍ يُقاس. لا يُطبعُ
# «boot: HEALTHY» إلّا إن نجح كلُّ سطر. عند السقوط: يقف، يسمّي الخطوةَ،
# لا يكمل صامتاً.
#
# **ما لا يفعله:**
#   • لا `colima start` للـdefault (لمنهاج · قاعدة CLAUDE.md §بيئة مشتركة).
#   • لا اعتمادَ على `MK_WORKER_DIR` الافتراضيّ (يشير إلى /tmp/160-main-tree
#     الذي يُمحى بالإقلاع — إحدى العلّات الليلة).
#   • لا launchd binding بعد — نشغّلُه بيدنا مرّةً ونقيسه ثمّ نربطه.
#
# **قاعدة bash 3.2 (درسُ ghost-watch v1):** لا `declare -A` ولا syntax
# مستحدَث لا يعرفه bash الافتراضيّ على macOS.

set -u  # -e يبطل fail-fast يدويّاً · pipefail لاحقاً إن احتيج

# ═════ ثوابت الحقيقة الوحيدة ═════════════════════════════════════════════════
REPO="/Users/mdervis/MediaKit/pf-mediakit"
SHOW_TREE="/Users/mdervis/MediaKit/pf-mediakit-show"
WORKER_DIR="$SHOW_TREE/apps/renderer"
COLIMA_PROFILE="mediakit"
DOCKER_CTX="colima-mediakit"
API_PORT=19070
STUDIO_PORT=19071
REDIS_PORT=19063
EXPECTED_PREFIX="pf-mediakit-show"
NODE_VERSION="v20.18.1"
NODE_BIN="$HOME/.nvm/versions/node/$NODE_VERSION/bin"
WORKER_LOG="$REPO/claude/reports/_boot-worker.log"
WORKER_PID_FILE="$REPO/claude/reports/_boot-worker.pid"

# tmux · الخمس + mkwatch + mkghost
TMUX_SESSIONS="mediakit mk-api mk-studio mkaudit mkci mkwatch mkghost"

# ═════ ألوان ورموز ═══════════════════════════════════════════════════════════
if [ -t 1 ]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_BLD=$'\033[1m'; C_DIM=$'\033[2m'; C_END=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_BLD=""; C_DIM=""; C_END=""
fi

STEP_TOTAL=11
STEP_NOW=0

step() {
  STEP_NOW=$((STEP_NOW + 1))
  printf '\n%s[%d/%d] %s%s\n' "$C_BLD" "$STEP_NOW" "$STEP_TOTAL" "$*" "$C_END"
}
pass()  { printf '  %s✓%s %s\n' "$C_GRN" "$C_END" "$*"; }
info()  { printf '  %s· %s%s\n'  "$C_DIM" "$*" "$C_END"; }
fail() {
  printf '  %s✗ FAILED:%s %s\n' "$C_RED" "$C_END" "$*" >&2
  printf '\n%s%sboot: FAILED at step [%d/%d]%s\n' \
    "$C_BLD" "$C_RED" "$STEP_NOW" "$STEP_TOTAL" "$C_END" >&2
  exit 1
}

# ═════ [1] preflight — أدواتٌ قبل الأفعال ══════════════════════════════════
step "preflight · أدواتٌ قبل الأفعال"

for tool in docker colima tmux curl lsof pgrep ps; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    fail "$tool غير موجود في PATH"
  fi
done
pass "docker · colima · tmux · curl · lsof · pgrep · ps — كلُّها موجودة"

# Node عبر PATH prepend لا عبر source (feedback-nvm-path-prepend)
if [ ! -x "$NODE_BIN/node" ]; then
  fail "node $NODE_VERSION غير موجود في $NODE_BIN — nvm install قبل هذا السكربت"
fi
if [ ! -x "$NODE_BIN/pnpm" ]; then
  fail "pnpm غير موجود في $NODE_BIN — corepack enable قبل هذا السكربت"
fi
export PATH="$NODE_BIN:$PATH"
pass "node=$(node --version) · pnpm=$(pnpm --version) — عبر PATH لا source"

# ملفّات المشروع
[ -d "$REPO" ]      || fail "REPO مفقود: $REPO"
[ -d "$SHOW_TREE" ] || fail "SHOW_TREE مفقود: $SHOW_TREE"
[ -x "$REPO/bin/mk-show" ] || fail "$REPO/bin/mk-show غير قابل للتنفيذ"
[ -f "$SHOW_TREE/.env.show" ] || fail "$SHOW_TREE/.env.show مفقود — bin/mk-show up أوّلاً لتوليده"
[ -f "$WORKER_DIR/src/api-worker.ts" ] || fail "$WORKER_DIR/src/api-worker.ts مفقود"
pass "بنية الملفّات · REPO · SHOW_TREE · mk-show · .env.show · api-worker.ts — سليمة"

# ═════ [2] colima mediakit — لا تلمس default (منهاج) ═══════════════════════
step "colima · profile=$COLIMA_PROFILE (لا تلمس default)"

colima_status="$(colima status --profile "$COLIMA_PROFILE" 2>&1 || true)"
if printf '%s' "$colima_status" | grep -q "is running"; then
  pass "colima [$COLIMA_PROFILE] is running — لا تشغيل"
else
  info "colima [$COLIMA_PROFILE] not running — أُشغّلُه (لا ألمس default)"
  colima start --profile "$COLIMA_PROFILE" >/dev/null 2>&1 \
    || fail "colima start --profile $COLIMA_PROFILE فشل"
  pass "colima [$COLIMA_PROFILE] started"
fi

# ═════ [3] docker context = colima-mediakit ════════════════════════════════
step "docker context · لا نلمس شيئاً خارج $DOCKER_CTX"

curr_ctx="$(docker context show 2>/dev/null || echo none)"
if [ "$curr_ctx" != "$DOCKER_CTX" ]; then
  info "context الحاليّ = $curr_ctx — أبدّله إلى $DOCKER_CTX"
  docker context use "$DOCKER_CTX" >/dev/null 2>&1 \
    || fail "تعذّر تبديل السياق إلى $DOCKER_CTX"
fi
curr_ctx="$(docker context show 2>/dev/null || echo none)"
[ "$curr_ctx" = "$DOCKER_CTX" ] || fail "context لا يزال '$curr_ctx' لا '$DOCKER_CTX'"
pass "docker context = $DOCKER_CTX"

# ═════ [4] mk-show up — containers + api + studio + seed ═══════════════════
# قاعدة idempotency: `mk-show up` يفشل إن كان المنفذُ محجوزاً — حتّى ولو
# كان الحجزُ لنفس الطقم (Colima SSH mux forwarding). لذلك نتحقّق أوّلاً:
# هل /v1/health يجيب؟ إن نعم، الطقمُ قائم، لا نستدعي mk-show up أصلاً.
step "mk-show up · حاويّات + api + studio + seed"

if lsof -nP -iTCP:"$API_PORT"    -sTCP:LISTEN >/dev/null 2>&1 \
&& lsof -nP -iTCP:"$STUDIO_PORT" -sTCP:LISTEN >/dev/null 2>&1 \
&& curl -fsS --max-time 3 "http://127.0.0.1:$API_PORT/v1/health" >/dev/null 2>&1; then
  pass "الطقمُ قائمٌ بالفعل · /v1/health يجيب — أتخطّى mk-show up"
else
  mk_show_log="$REPO/claude/reports/_boot-mk-show.log"
  info "الطقمُ غيرُ قائم — أُشغّل mk-show up (log=$mk_show_log)"
  if ! "$REPO/bin/mk-show" up > "$mk_show_log" 2>&1; then
    tail -30 "$mk_show_log" >&2
    fail "mk-show up رجع بغير صفر — راجع $mk_show_log"
  fi
  pass "mk-show up رجع بصفر"
fi

# ═════ [5] العامل · من شجرة العرض · .env.show · بادئة $EXPECTED_PREFIX ═════
step "العامل · $WORKER_DIR · .env.show · بادئة=$EXPECTED_PREFIX"

# هل عاملٌ حيٌّ بالفعل؟ (شرط §٢·٣ من mk-worker: عاملان أسوأ من صفر)
existing_pid="$(pgrep -f 'src/api-worker.ts' 2>/dev/null | head -1 || true)"
if [ -n "$existing_pid" ]; then
  info "العامل يعمل مسبقاً · PID=$existing_pid — لا أُنشئ ثانياً"
  pass "worker PID=$existing_pid (existing)"
else
  info "لا عامل حيّ — أُشغِّلُه من $WORKER_DIR"
  # الأسرار من .env.show — لا تُطبع (feedback-names-not-values)
  set -a
  # shellcheck disable=SC1091
  . "$SHOW_TREE/.env.show"
  set +a

  # تحقّق أنّ .env.show أعطانا البادئةَ المتوقَّعة (بلا طباعة قيَم أخرى)
  if [ "${BULLMQ_PREFIX:-}" != "$EXPECTED_PREFIX" ]; then
    fail ".env.show أعطى BULLMQ_PREFIX=${BULLMQ_PREFIX:-<فارغة>} لا $EXPECTED_PREFIX"
  fi
  info "BULLMQ_PREFIX من .env.show = $EXPECTED_PREFIX ✓"

  # أطلق العامل — cwd صريحاً · نsplit من subshell للحفاظ على PID الأمّ
  (
    cd "$WORKER_DIR"
    nohup node --import tsx src/api-worker.ts > "$WORKER_LOG" 2>&1 &
    echo $! > "$WORKER_PID_FILE"
    disown 2>/dev/null || true
  )
  sleep 4

  new_pid="$(pgrep -f 'src/api-worker.ts' 2>/dev/null | head -1 || true)"
  [ -n "$new_pid" ] || fail "العامل لم يبدأ خلال 4s — راجع $WORKER_LOG"
  pass "worker PID=$new_pid · log=$WORKER_LOG"
fi

# ═════ [6] tmux · mkwatch · الخمس · mkghost ════════════════════════════════
step "tmux · mkwatch · الخمس · mkghost"

created=0
existed=0
for s in $TMUX_SESSIONS; do
  if tmux has-session -t "$s" 2>/dev/null; then
    existed=$((existed + 1))
    continue
  fi
  case "$s" in
    mkwatch)
      tmux new-session -d -s "$s" "bash $REPO/claude/bin/mk-watch.sh" \
        || fail "tmux new-session $s فشل"
      ;;
    mkghost)
      tmux new-session -d -s "$s" "bash $REPO/claude/bin/mk-ghost-watch.sh" \
        || fail "tmux new-session $s فشل"
      ;;
    *)
      # الخمس · قذائف فارغة · المالكُ يُشغّل claude يدوياً بعد الوصل
      tmux new-session -d -s "$s" \
        || fail "tmux new-session $s فشل"
      ;;
  esac
  created=$((created + 1))
done
pass "tmux · $existed كانت قائمة · $created أُنشئت الآن"

# ═════════════════════════════════════════════════════════════════════════════
# ═════ PROOF — سطرُ قياسٍ لكلّ قطعةٍ · لا كلمةَ «يعمل» بلا برهان ═══════════
# ═════════════════════════════════════════════════════════════════════════════

# ── [7] proof · API port + /v1/health commit ───────────────────────────────
step "proof · API $API_PORT + /v1/health"

if ! lsof -nP -iTCP:"$API_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  fail "API port $API_PORT لا يستمع"
fi
health_body="$(curl -fsS --max-time 5 "http://127.0.0.1:$API_PORT/v1/health" 2>/dev/null || true)"
[ -n "$health_body" ] || fail "/v1/health لا يجيب"

# استخلاص commit + cwd من JSON — بلا jq · node يفعلها بأمان
health_commit="$(printf '%s' "$health_body" | node -e '
  let s=""; process.stdin.on("data",d=>s+=d); process.stdin.on("end",()=>{
    try { console.log(JSON.parse(s).commit || ""); } catch(e){ console.log(""); }
  });' 2>/dev/null || echo "")"
health_cwd="$(printf '%s' "$health_body" | node -e '
  let s=""; process.stdin.on("data",d=>s+=d); process.stdin.on("end",()=>{
    try { console.log(JSON.parse(s).cwd || ""); } catch(e){ console.log(""); }
  });' 2>/dev/null || echo "")"

[ -n "$health_commit" ] || fail "/v1/health رجع بلا حقل commit — الرَّدُّ ليس JSON متوقَّعاً"
[ -n "$health_cwd" ]    || fail "/v1/health رجع بلا حقل cwd"

# cwd يجب أن يكون تحت شجرة العرض
case "$health_cwd" in
  "$SHOW_TREE"/*) : ;;
  *) fail "/v1/health cwd=$health_cwd ليس تحت $SHOW_TREE" ;;
esac
pass "API $API_PORT LISTEN · /v1/health commit=$health_commit · cwd=$health_cwd"

# ── [8] proof · Studio port ─────────────────────────────────────────────────
step "proof · Studio $STUDIO_PORT"

lsof -nP -iTCP:"$STUDIO_PORT" -sTCP:LISTEN >/dev/null 2>&1 \
  || fail "Studio port $STUDIO_PORT لا يستمع"
pass "Studio $STUDIO_PORT LISTEN"

# ── [9] proof · العامل كما يراه نفسُه (cwd من lsof · لا من ظنّنا) ─────────
step "proof · العامل · معرِّفُه ومسارُه ووصلتُه · كما يراها هو"

worker_pid="$(pgrep -f 'src/api-worker.ts' 2>/dev/null | head -1 || true)"
[ -n "$worker_pid" ] || fail "العامل مفقود (pgrep لم يجد src/api-worker.ts)"

# cwd من jdول الـkernel · ليس من env أطلقناها
worker_cwd="$(lsof -p "$worker_pid" -a -d cwd -F n 2>/dev/null | tail -1 | sed 's/^n//')"
[ -n "$worker_cwd" ] || fail "تعذّر قراءة cwd للعامل $worker_pid من lsof"
[ "$worker_cwd" = "$WORKER_DIR" ] \
  || fail "worker cwd=$worker_cwd لا $WORKER_DIR — تشغيلٌ من شجرةٍ خطأ"

# وصلة Redis على منفذ الشوروم — إثباتُ بيئةِ العامل من طرف الشبكة
redis_conns="$(lsof -p "$worker_pid" -a -iTCP -sTCP:ESTABLISHED 2>/dev/null \
  | grep -c ":$REDIS_PORT " || true)"
redis_conns="${redis_conns:-0}"
[ "$redis_conns" -gt 0 ] \
  || fail "العامل $worker_pid ليس متصلاً بـRedis الشوروم على $REDIS_PORT — قد يكون على redis آخر"

pass "worker PID=$worker_pid · cwd=$worker_cwd · redis:$REDIS_PORT ($redis_conns وصلات)"

# ── [10] proof · tmux · كلُّ الشاشات المتوقَّعة قائمة ───────────────────────
step "proof · tmux · $TMUX_SESSIONS"

missing=""
for s in $TMUX_SESSIONS; do
  if ! tmux has-session -t "$s" 2>/dev/null; then
    missing="$missing $s"
  fi
done
[ -z "$missing" ] || fail "شاشاتٌ ناقصة:$missing"
count="$(echo "$TMUX_SESSIONS" | wc -w | tr -d ' ')"
pass "tmux · $count/$count شاشات قائمة"

# ── [11] proof · docker containers show project alive ──────────────────────
step "proof · حاويّات $DOCKER_CTX · مشروع pf-mediakit-show"

# نحصل على أسماء الحاويّات ذات البادئة · نطلب ثلاثةً على الأقلّ (pg · redis · minio)
running_containers="$(docker ps --filter 'name=pf-mediakit-show-' --filter 'status=running' \
  --format '{{.Names}}' 2>/dev/null | wc -l | tr -d ' ')"
running_containers="${running_containers:-0}"
[ "$running_containers" -ge 3 ] \
  || fail "حاويّات pf-mediakit-show الحيّة = $running_containers · متوقَّع ≥ 3"
pass "docker · $running_containers حاويّة حيّة ببادئة pf-mediakit-show-"

# ═════════════════════════════════════════════════════════════════════════════
printf '\n%s%sboot: HEALTHY%s · كلُّ %d خطوةٍ نجحت\n' \
  "$C_BLD" "$C_GRN" "$C_END" "$STEP_TOTAL"

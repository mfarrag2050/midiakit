#!/usr/bin/env bash
# bin/mk-worker — أمرٌ واحد لعامل الرندر (316-ONE-COMMAND-FOR-THE-WORKER).
#
# **لماذا:** الليلة أوقِف/أُعيد العامل ٣ مرّات بأمرٍ يُكتب من الرأس في كلّ
# مرّة. مرّةً أُعيد أثناء بوّابة تقيس · فَسَد قياس كامل. الحلّ: أمرٌ واحد
# مسمّى · يعرف موضع العامل · يسجّل نفسه · يرفض التكرار.
#
# **الملكيّة (315):** أرض mediakit (العامل + بوّابة الدمج). mkapi يبني ·
# mediakit تستعمل. mkapi تستعمل بعد رفع التجميد.
#
# **الأفعال:**
#   status   — يقرأ الحال · لا يغيّر شيئاً · آمن من أيّ جلسة (لا سطر ledger).
#   start    — يبدأ إن غاب. **يرفض إن حيّ** (عاملان أسوأ من صفر · شرط §٢·٣).
#   stop     — يوقف إن حيّ. يقول «موقوف بالفعل» إن غاب.
#   restart  — stop ثم start.
#
# **_worker.md ledger:** يُلحق سطر عند كل فعل يغيّر الحال (start/stop/restart)
# بالصيغة القائمة. `status` لا يكتب.
#
# **من طلب الفعل:** env `MK_SESSION` أو وسيط `--by=<name>` أو `unknown`.
# **موضع العامل:** env `MK_WORKER_DIR` بقيمة افتراضيّة معلنة أدناه — شرط §٢·٤.

set -euo pipefail

# ── ثوابت وحيدة (شرط §٢·٤ · موضع واحد معلَن) ────────────────
# **الافتراضيّ من موضع السكربت** — لا افتراضٌ في `/tmp` يموت مع كلّ
# إعادة تشغيل (290 · §١·١). إن كان السكربت في `<root>/bin/mk-worker`،
# فالافتراضيّ `<root>/apps/renderer`. عند حاجةٍ لتشغيل من شجرةٍ أخرى
# (مثلاً `pf-mediakit-show`) يُعيَّن `MK_WORKER_DIR` صراحةً.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKER_DIR="${MK_WORKER_DIR:-${SCRIPT_DIR%/bin}/apps/renderer}"
WORKER_CMD="node --import tsx src/api-worker.ts"
LEDGER_PATH="${MK_LEDGER_PATH:-/Users/mdervis/MediaKit/pf-mediakit/claude/reports/_worker.md}"
SESSION="${MK_SESSION:-unknown}"

# ── إعدادات Redis من البيئة (لا `:6379` مثبَّت — 290 · §١·٣) ──
# REDIS_URL هو المصدر الحاكم. تُشتَقّ منه المضيف والمنفذ ورقم الـDB.
# MK_REDIS_DB (إن وُجد) يتجاوز DB من URL — للاختبار.
REDIS_URL="${REDIS_URL:-redis://127.0.0.1:6379/${MK_REDIS_DB:-0}}"
if [[ "$REDIS_URL" =~ ^redis://([^:/]+):([0-9]+)/([0-9]+)$ ]]; then
  REDIS_HOST="${BASH_REMATCH[1]}"
  REDIS_PORT="${BASH_REMATCH[2]}"
  REDIS_DB="${MK_REDIS_DB:-${BASH_REMATCH[3]}}"
else
  echo "[mk-worker] FATAL: REDIS_URL شكلٌ خاطئ: ${REDIS_URL}" >&2
  echo "  المتوقَّع: redis://<host>:<port>/<db>" >&2
  exit 65
fi

# ── وسيط --by=<name> يتجاوز env ─────────────────────────────
for arg in "$@"; do
  case "$arg" in
    --by=*) SESSION="${arg#--by=}" ;;
  esac
done

# ── مساعِدات ───────────────────────────────────────────────
find_pid() {
  # نستعمل pgrep -f بدقّة عالية: نمط يتضمّن مسار src/api-worker.ts.
  # `[[:space:]]*$` يسمح بمسافات لاحقة — يقتنص العمليّات التي تُعيد كتابة
  # `process.title` (تُبقي ذيلَ مسافات من buffer argv الأصليّ · حادثة
  # اختبار 290 · §١·هوستايل-٢).
  # **عند التطابق المتعدِّد** نُحذّر على stderr ونُعيد الأوّل — الصمت
  # يخفي كذبةً خطيرة (عاملان على نفس الطابور · شرط §٢·٣).
  local all count
  all=$(pgrep -f "${WORKER_CMD}[[:space:]]*$" 2>/dev/null || true)
  [ -z "$all" ] && return
  count=$(echo -n "$all" | grep -c '^' 2>/dev/null || echo 0)
  if [ "$count" -gt 1 ]; then
    local pids
    pids=$(echo "$all" | tr '\n' ' ' | sed 's/ $//')
    echo "[mk-worker] ⚠ WARN: ${count} عمليّات تطابق النمط — سأعمل على الأوّل. PIDs: ${pids}" >&2
    echo "  استعمل: 'pgrep -fl \"${WORKER_CMD}\"' لرؤية سطر كلٍّ." >&2
  fi
  echo "$all" | head -1
}

get_ppid() {
  ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ' || echo "?"
}

get_etime() {
  ps -o etime= -p "$1" 2>/dev/null | tr -d ' ' || echo "?"
}

# **cwd الحيّ من العمليّة نفسِها** — لا الافتراضيّ ولا env. `lsof -d cwd`
# يعيد سطراً واحداً بمسار working directory الفعليّ للعمليّة (290 · §١·٢).
get_live_cwd() {
  lsof -a -d cwd -p "$1" 2>/dev/null | awk 'NR==2 {print $NF}' || echo "?"
}

count_redis_clients() {
  # يقرأ من REDIS_HOST:REDIS_PORT — لا `-n` وحده الذي يفترض localhost:6379
  # (290 · §١·٣). فشل الاتصال (منفذ خطأ) يعيد 0 لا يُسقط السكربت.
  # نستعمل awk لضمان مخرَج رقميّ نظيف (بلا كذبة «0\n0» — §١·هوستايل-١).
  local out
  out=$(redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" -n "$REDIS_DB" CLIENT LIST 2>/dev/null) || true
  echo -n "$out" | awk 'NF>0 {c++} END {print c+0}'
}

worker_connected_redis() {
  # يقرأ المنفذ من REDIS_URL — لا `:6379` مثبَّت (290 · §١·٣).
  # awk بدل `grep -c || echo 0` — الأخير يُخرج «0\n0» عند عدم مطابقة
  # (grep -c يطبع 0 ثمّ يخرج بحالة 1 فيُشغل `|| echo 0` مرّةً ثانية).
  # **نمطُ المنفذ محبوسٌ بحدّ يمين** (`[ )]`) — بلا هذا يلتقط :6379
  # ضحيّةَ :63797، و:3 ضحيّةَ :3306. 290 · §١·هوستايل-٣.
  # كذلك نطلب `->` قبل المنفذ ليقتصر على الطرف البعيد (Redis) لا المحلّي.
  local pid="$1"
  local out
  out=$(lsof -p "$pid" -i -a 2>/dev/null) || true
  echo -n "$out" | awk -v pat="->[^ ]*:${REDIS_PORT}[ )]" '$0 ~ pat && /ESTABLISHED/ {c++} END {print c+0}'
}

now_iso() {
  date "+%Y-%m-%d %H:%M:%S %z" | sed 's/\([+-]\)\([0-9][0-9]\)\([0-9][0-9]\)/\1\2/'
}

append_ledger() {
  local action="$1" pid="$2" ppid="$3" cwd="${4:-$WORKER_DIR}"
  # cwd يُمرَّر من المُنادي — يتقاطها من العمليّة الحيّة قبل kill (290 · §١·٢).
  # فallback على env عند تعذّر القياس (عمليّة ماتت قبل القياس).
  local clients
  clients=$(count_redis_clients)
  local line
  line="$(now_iso) · PID ${pid} (PPID ${ppid}) · ${action}-by: ${SESSION} · cwd ${cwd} · Redis DB/${REDIS_DB} (${clients} clients)."
  echo "$line" >> "$LEDGER_PATH"
}

# ── الأفعال ────────────────────────────────────────────────
cmd_status() {
  local pid ppid etime clients rc live_cwd
  pid=$(find_pid)
  clients=$(count_redis_clients)
  if [ -z "$pid" ]; then
    echo "[mk-worker] status: DOWN · لا process يطابق '${WORKER_CMD}'."
    echo "  cwd (would-be): ${WORKER_DIR}"
    echo "  Redis DB/${REDIS_DB}: ${clients} clients (لا يشمل العامل)."
    return 1
  fi
  ppid=$(get_ppid "$pid")
  etime=$(get_etime "$pid")
  rc=$(worker_connected_redis "$pid")
  live_cwd=$(get_live_cwd "$pid")
  echo "[mk-worker] status: UP · PID ${pid} (PPID ${ppid}) · uptime ${etime}."
  # cwd الحيّ من lsof — لا env ولا الافتراضيّ (290 · §١·٢).
  echo "  cwd (live): ${live_cwd}"
  if [ "$live_cwd" != "$WORKER_DIR" ]; then
    echo "  cwd (env/default): ${WORKER_DIR}  ← [لا يطابق العمليّة الحيّة]"
  fi
  # عرض Redis يعتمد على العدد — أخضر/أحمر واضح (290 · §١·٣).
  if [ "${rc:-0}" -gt 0 ]; then
    echo "  Redis: متّصل (${REDIS_HOST}:${REDIS_PORT}/DB${REDIS_DB}) · ${rc} sockets من العامل · ${clients} clients إجماليّ."
  else
    echo "  Redis: منقطع (${REDIS_HOST}:${REDIS_PORT}/DB${REDIS_DB}) · 0 sockets من العامل · ${clients} clients إجماليّ."
  fi
  return 0
}

cmd_start() {
  local pid
  pid=$(find_pid)
  if [ -n "$pid" ]; then
    # شرط §٢·٣: عاملان أسوأ من صفر · نرفض التكرار.
    echo "[mk-worker] start: REJECTED · العامل حيّ بالفعل (PID ${pid} · PPID $(get_ppid "$pid"))."
    echo "  لن أُنشئ ثانياً — عاملان على الطابور يستهلكان الـjobs مرّتين."
    echo "  للإعادة (kill + start): استعمل 'mk-worker restart'."
    return 1
  fi
  if [ ! -d "$WORKER_DIR" ]; then
    echo "[mk-worker] start: FAILED · WORKER_DIR غير موجود: ${WORKER_DIR}"
    return 2
  fi
  if [ ! -f "${WORKER_DIR}/src/api-worker.ts" ]; then
    echo "[mk-worker] start: FAILED · src/api-worker.ts غير موجود في ${WORKER_DIR}"
    return 2
  fi
  echo "[mk-worker] start: launching from ${WORKER_DIR} ..."
  local log_path="${MK_WORKER_LOG:-/tmp/mk-worker.log}"
  (
    cd "$WORKER_DIR"
    nohup ${WORKER_CMD} > "$log_path" 2>&1 &
    disown 2>/dev/null || true
  )
  sleep 4
  pid=$(find_pid)
  if [ -z "$pid" ]; then
    echo "[mk-worker] start: FAILED · العامل لم يبدأ (تحقّق ${log_path})."
    return 3
  fi
  local ppid live_cwd
  ppid=$(get_ppid "$pid")
  live_cwd=$(get_live_cwd "$pid")
  echo "[mk-worker] start: OK · PID ${pid} (PPID ${ppid}) · log: ${log_path}"
  append_ledger "start" "$pid" "$ppid" "$live_cwd"
  return 0
}

cmd_stop() {
  local pid ppid live_cwd
  pid=$(find_pid)
  if [ -z "$pid" ]; then
    echo "[mk-worker] stop: SKIP · موقوف بالفعل (لا process يطابق)."
    return 0
  fi
  ppid=$(get_ppid "$pid")
  # اقرأ cwd الحيّ قبل kill — بعده يفوت وقت القياس (290 · §١·٢).
  live_cwd=$(get_live_cwd "$pid")
  echo "[mk-worker] stop: killing PID ${pid} (PPID ${ppid}) ..."
  kill "$pid" 2>/dev/null || true
  # انتظر حتّى 5 ثوان
  local i=0
  while [ $i -lt 5 ] && [ -n "$(find_pid)" ]; do
    sleep 1; i=$((i + 1))
  done
  if [ -n "$(find_pid)" ]; then
    echo "[mk-worker] stop: escalating (SIGKILL على $pid) ..."
    kill -9 "$pid" 2>/dev/null || true
    sleep 1
  fi
  if [ -n "$(find_pid)" ]; then
    echo "[mk-worker] stop: FAILED · process لا يزال حيّاً"
    return 4
  fi
  echo "[mk-worker] stop: OK · PID ${pid} انتهى."
  append_ledger "stop" "$pid" "$ppid" "$live_cwd"
  return 0
}

cmd_restart() {
  cmd_stop
  cmd_start
}

# ── dispatcher ─────────────────────────────────────────────
case "${1:-}" in
  status)  cmd_status ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  ""|help|-h|--help)
    cat <<EOF
Usage: mk-worker <action> [--by=<session>]

Actions:
  status   — يقرأ الحال · لا يغيّر شيئاً · لا يكتب ledger.
  start    — يبدأ العامل إن غاب. يرفض إن حيّ (عاملان أسوأ من صفر).
  stop     — يوقف العامل إن حيّ.
  restart  — stop ثم start.

Env:
  MK_WORKER_DIR    مسار العامل (default: ${WORKER_DIR}).
  MK_LEDGER_PATH   مسار _worker.md (default: ${LEDGER_PATH}).
  REDIS_URL        redis://<host>:<port>/<db> (current: ${REDIS_URL}).
  MK_REDIS_DB      يتجاوز DB من URL — للاختبار (current: ${REDIS_DB}).
  MK_SESSION       اسم الجلسة الطالبة (default: ${SESSION}).
  MK_WORKER_LOG    مسار log (default: /tmp/mk-worker.log).

Session (لأجل ledger):
  MK_SESSION=mkapi mk-worker start
  mk-worker start --by=mkapi
EOF
    ;;
  *)
    echo "[mk-worker] unknown action: $1" >&2
    echo "  استعمل: status · start · stop · restart · help" >&2
    exit 64
    ;;
esac
